#
# The environment a browser-test run happens in — WP8.
#
# `composer test:dusk` copies this file over `.env` for the duration of the
# run (backing the real one up to `.env.dusk-backup`) and puts it back
# afterwards, so the `php artisan serve` process the browser talks to and the
# `php artisan dusk` process that seeds the database are looking at exactly the
# same configuration. `php artisan dusk` on its own does the same swap, by the
# same filename convention.
#
# Everything below that differs from `.env.example` differs on purpose. Read
# the WP8 section of CLAUDE.md before changing any of it.
#

APP_NAME=ColoringBook
APP_ENV=testing

# Deliberately not the development key: this file is committed, and a key that
# is public is a key that must never have decrypted anything real.
APP_KEY=base64:7jzDR2BdEcfv2ZDGW/A0FZaYyo0hE6Tg4Bxgq4y8LKk=

# On, so a failing test screenshots a real stack trace rather than "Server
# Error". Nothing here is reachable from outside the box.
APP_DEBUG=true

# Port 8991, not 8000: `composer dev` may well be running the real app on 8000
# against the real database, and a browser test that quietly drove *that* would
# be the worst possible outcome. The runner starts a server here itself.
APP_URL=http://127.0.0.1:8991

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Four rounds, not twelve. Every browser test signs somebody in.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A real file, never `:memory:` and never `database/database.sqlite`.
#
# Two processes are involved — the browser hits `php artisan serve`, the test
# seeds through `php artisan dusk` — so an in-process database would leave the
# server looking at an empty one. And it is a *separate* file from the
# development database because `DatabaseMigrations` runs `migrate:fresh`
# before every single test: pointed at `database/database.sqlite`, one Dusk run
# would wipe the developer's own data.
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

# Database sessions, matching the deployed configuration: the login/logout
# tests are only worth anything if the session store is the one production
# uses. `migrate:fresh` between tests drops the table with everything else,
# which is fine — every test signs in for itself.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Sync: a browser click that queues a job must have finished doing it by the
# time the redirect lands, or the assertion after it is a race.
QUEUE_CONNECTION=sync

CACHE_STORE=array

# No mail leaves the box. `log` rather than `array` so a registration test can
# still be debugged by reading storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ColoringBook — see config/coloringbook.php and docs/DLC_SERVER.md.
#
# The one setting with real teeth: the private content tree moves to
# storage/app/private/dusk/{packs,assets,paint}. Browser tests need *real*
# files on those disks (Storage::fake only exists inside the test process, and
# the bytes have to be there for the separate server process to serve), so a
# run genuinely writes pack zips, content-addressed assets and paint PNGs. Sent
# somewhere of their own, they can be deleted wholesale at the start of the
# next run without touching anything the developer painted.
COLORINGBOOK_PRIVATE_ROOT=private/dusk

COLORINGBOOK_ACCEL_REDIRECT=false
COLORINGBOOK_TOKEN_TTL_DAYS=90
COLORINGBOOK_SIGNED_URL_TTL_MINUTES=10
